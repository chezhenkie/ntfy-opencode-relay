# Copy to .env beside compose.yml and fill in the first value.
# The public HTTPS name the phone reaches; a TLS terminator listens on 443.
NTFY_BASE_URL=https://ntfy.example.com
# true when a reverse proxy terminates TLS in front of the container.
NTFY_BEHIND_PROXY=true
# Host port mapped to container 8080.
NTFY_PORT=8810
